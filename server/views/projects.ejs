<%#Import the header%>
<%- include('templates/header'); -%>
<%#/Import the header%>

<section class="projects">
  <div class="projects-container">
  <div class="projects-masthead">
    <h1>Harry and Hermione Projects</h1>
    <time>2020 — 2026</time>
  </div>

  <section class="projects-hero">
    <div>
      <h2>Harry and Hermione <br>Projects</h2>
      <p class="projects-hero-text">Below is the comprehensive list of projects that have been undertaken within the Harry and Hermione fandom over the course of the past decade or so.</p><br>
    </div>

  </section>

    <%# Projects List Loop %>
    <% projectslist.forEach(function(projects) { %>

  <section class="projects-body-content">
    <div class="projects-section-label"><%= projects.title %></div>
    <div class="projects-body-text">

      <p><%= projects.summary %></p>
      <p class="projects-caption">Artwork by — <%= projects.artwork %></p>

      <a href="/projects/<%= projects.shortname %>" class="btn btn-sm w-25 btn-primary">View Project</a>
    </div>
    
    <div class="projects-grid-image">
      <a href="/projects/writers">
      <img src="<%= projects.image %>" alt="writers">
      </a>
    </div>

  </section>


    <section class="projects-divider-section"></section>
    <%  }); %>
    <%# / Projects List Loop %>






  <div class="projects-footer">
    <p>Projects Page</p>
    <p>Harry and Hermione</p>
  </div>
</div>
</section>





<%#Import the footer%>
<%- include('templates/footer'); -%>
<%#/Import the footer%>