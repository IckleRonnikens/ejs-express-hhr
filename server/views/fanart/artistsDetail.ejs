<%# Import the header%>
<%- include('../templates/header'); -%>
<%# /Import the header%>

<section class="fanart">
  <div class="fanart-container">
<%# Artists Details %>

  <div class="fanart-masthead">
    <h1>Artists</h1>
    <time>Updated — 2026</time>
  </div>

  <section class="fanart-hero">
    <div>
      <h2><%= artists.name %></h2>
      <p class="fanart-hero-text"><%= artists.summary %></p>
    </div>
  <section class="fanart-featured">
    <div class="fanart-image-placeholder">
        <img src="/images/artists/<%= artists.shortname %>.jpg" class="d-block mx-lg-auto img-fluid" alt="Photo of <%= artists.title %>" width="700" height="500" loading="lazy">
    </div>
    <p class="fanart-caption"><%= artists.name %> — Social media: <%= artists.aurl %></p>
  </section>
    
  </section>


  <section class="fanart-quote-section">
    <blockquote>
      "Perfection is achieved not when there is nothing more to add, but when there is nothing left to take away."
    </blockquote>
    <p class="fanart-quote-attribution">— Antoine de Saint-Exupéry</p>
  </section>



  <section class="fanart-image-grid">
    <%# Fanart %>
    <% if (fanart.reverse().length > 0) { %>
    <%for (i=0; i < fanart.length; i ++){ %>
    <div class="fanart-grid-image">
      <a href="/images/fanart/<%= artists.shortname %>/<%= fanart[i] %>.jpg" data-lightbox="<%= artists.shortname %>" data-title="<%= artists.shortname %>">
      <img class="w-100" src="/images/fanart/<%= artists.shortname %>/<%= fanart[i] %>.jpg" alt="Photo of <%= fanart[i] %>" >
      </a>
    </div>
    <%}%>
    <% }  %>
    <%# /Fanart %>
  </section>

  <div class="fanart-footer">
    <p><a href="/fanart/artists">Back to Artists</a></p>
    <p><%= artists.name %></p>
  </div>

<%# /Artists Details %>

</div>
</section>


<%# Import the footer %>
<%- include('../templates/footer'); -%>
<%# /Import the footer %>