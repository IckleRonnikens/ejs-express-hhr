<%#Import the header%>
<%- include('../templates/header'); -%>
<%#/Import the header%>

<section class="fanfiction" id="allwriters">
  <div class="fanfiction-container">
    <div class="fanfiction-masthead">
    <h1>writers</h1>
    <time>Updated — Winter 2026</time>
  </div>

      <section class="fanfiction-image-grid">

        <%# writers List Loop %>
        <% writerslist.forEach(function(writers) { %>
        <div class="fanfiction-image-container">
          <div class="fanfiction-grid-image">
            <a href="/fanfiction/writers/<%= writers.shortname %>">
              <img class="w-100 " src="/images/writers/<%= writers.shortname %>.jpg" alt="Photo of <%= writers.shortname %>">
            </a>

            <div class="fanfiction-image-overlay">
              <div class="fanfiction-image-text">
                <a href="/fanfiction/writers/<%= writers.shortname %>">
                  <%= writers.name %></div>
                </a>
            </div>

          </div>
        </div>
        <%  }); %>
        <%# / writers List Loop %>
      </section>

        <div class="fanfiction-footer">
    <p>Writers Page</p>
    <p>Harry and Hermione</p>
  </div>

  </div>
</section>
<%#Import the footer%>
<%- include('../templates/footer'); -%>
<%#/Import the footer%>