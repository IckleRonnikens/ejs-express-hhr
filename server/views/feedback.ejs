<%# Import the header %>
<%- include('templates/header'); -%>
<%# /Import the header %>

<section class="feedback">
  <div class="feedback-container">
  <div class="feedback-masthead">
    <h1>Feedback Form</h1>
  </div>

  <section class="feedback-hero">
    <div>
      <h2>Have Your Say</h2>
      <p class="feedback-hero-text">If you would like to leave a comment about the site, make a suggestion, or see something changed, then please do so by filling out the form below.</p>
    </div>
  </section>


<%# Feedback Form %>
  <form class="feedback-form" action="/feedback" method="POST">

  <section class="feedback-body-content">
    
    <div class="feedback-section-label">Name</div>
    <div class="feedback-body-text">
      <p><input class="form-control" id="feedback-form-name" type="text" placeholder="Enter your name" name="fbName"></p>
    </div>
  </section>

  <section class="feedback-body-content">
    <div class="feedback-section-label">Title</div>
    <div class="feedback-body-text">
      <p><input class="form-control" id="feedback-form-title" type="text" placeholder="Title of your feedback" name="fbTitle"></p>
    </div>
  </section>

  <section class="feedback-body-content">
    <div class="feedback-section-label">Message</div>
    <div class="feedback-body-text">
      <p><textarea class="form-control" id="feedback-form-message" type="text" placeholder="Enter your message, then hit the submit" rows="6" name="fbMessage"></textarea></p>
    </div>
  </section>

  <section class="feedback-body-content">
    <div class="feedback-section-label"></div>
    <div class="feedback-body-text">
      <p>            <button class="btn btn-dark" type="submit">Submit</button>
            <button class="btn btn-danger" type="submit">Clear</button>
            <button class="btn btn-primary"><a href="/feedback#subfeedback">Read Feedback</a></button></p>
    </div>
  </section>
  <%# /Feedback Form %>



<div class="feedback-masthead">
<h1>Feedback Messages</h1>
</div>
<%# Feedback List Loop %>
<% feedbacklist.forEach(function(item) { %> 
  <section class="feedback-two-column">
    <div class="feedback-section-label"><%= item.name %></div>
    <div class="feedback-columns">
      <div class="feedback-column-text">
        <p><%= item.title %></p>
      </div>
      <div class="feedback-column-text">
        <p><%= item.message %></p>
      </div>
    </div>
  </section>
<%  }); %>
<%# Feedback List Loop %>


  <div class="feedback-footer">
    <p>Feedback Page</p>
    <p>Harry and Hermione</p>
  </div>
</div>
</section>

<%# Import the footer %>
<%- include('templates/footer'); -%>
<%# /Import the footer %>